PORT=5000
CLIENT_URL=http://localhost:5173

# Generate a long random string, e.g. `openssl rand -hex 64`
JWT_SECRET=replace_with_a_long_random_secret

# Telegram Bot credentials (https://core.telegram.org/bots#how-do-i-create-a-bot)
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Used only to create the first admin account on initial server start.
# After admin.json is created, these values are no longer read.
ADMIN_INITIAL_NAME=Jomari Lacano
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password
